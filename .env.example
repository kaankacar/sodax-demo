# ─────────────────────────────────────────────────────────────────────────────
# SODAX demo — environment
# Copy to `.env` and fill in only what you need. EVERYTHING works with NO keys:
# the tour falls back to read-only + a self-funded Stellar TESTNET signing demo.
# ─────────────────────────────────────────────────────────────────────────────

# ── Stellar TESTNET signing (OPTIONAL) ───────────────────────────────────────
# The tour generates + friendbot-funds a fresh testnet keypair automatically,
# so you do NOT need to set this. Provide one only to sign from a specific
# testnet account. Must be a Stellar SECRET SEED (starts with "S", 56 chars) —
# NOT a 0x hex key (the StellarWalletProvider runs Keypair.fromSecret()).
STELLAR_TESTNET_SECRET=

# Override the testnet Horizon endpoint for the signing scene (defaults to the
# public testnet Horizon). Must be a TESTNET Horizon.
STELLAR_TESTNET_HORIZON_URL=

# ── LIVE MAINNET execution (OPTIONAL, real funds, uncapped) ───────────────────
# SODAX's protocol is mainnet-only. To actually broadcast a real cross-chain
# swap you must (1) set SODAX_EXECUTE=1 AND (2) supply funded mainnet keys below.
# Without BOTH, the tour only BUILDS the (unsigned) intent and prints it.
# WARNING: when armed, this moves REAL funds with NO amount cap. You were warned.
SODAX_EXECUTE=0

# Funded Stellar MAINNET secret seed ("S..."). Used as swap source/destination.
STELLAR_MAINNET_SECRET=

# Funded EVM MAINNET private key ("0x...") — source side of EVM→Stellar swaps.
EVM_MAINNET_PRIVATE_KEY=

# Amount of USDC moved per live swap, in human units. There is NO cap — this exact
# amount is what executes when armed. Default 0.5.
SODAX_SWAP_AMOUNT=0.5

# Explicit swap destination, if you only have ONE mainnet key:
#   - EVM key set  → provide a Stellar destination here to run EVM→Stellar
SODAX_STELLAR_DST=
#   - Stellar key set → provide an EVM destination here to run Stellar→EVM
SODAX_EVM_DST=

# Optional RPC overrides (sensible public defaults are used if omitted).
SONIC_RPC_URL=
ARBITRUM_RPC_URL=
BASE_RPC_URL=
STELLAR_HORIZON_URL=

# ── Web app (OPTIONAL) ────────────────────────────────────────────────────────
# WalletConnect project id for EVM mobile wallets in the dApp (optional).
NEXT_PUBLIC_WC_PROJECT_ID=
